{
    "name": "saifulferoz/symfony-horizon",
    "description": "Laravel Horizon style dashboard, supervisor and per-job metrics (runtime, memory) for Symfony Messenger",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "messenger",
        "horizon",
        "queue",
        "worker",
        "dashboard",
        "monitoring",
        "metrics"
    ],
    "authors": [
        {
            "name": "Saiful Islam Feroz",
            "email": "saifulferoz@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.0 || ^8.0",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "symfony/mercure": "^0.6 || ^0.7 || ^0.8 || ^0.9 || ^0.10"
    },
    "suggest": {
        "ext-pcntl": "For graceful shutdown of the horizon supervisor on SIGTERM/SIGINT",
        "ext-redis": "Fastest Redis client for metrics storage (phpredis)",
        "predis/predis": "Pure PHP Redis client, used when ext-redis is not available",
        "symfony/mercure-bundle": "Real-time dashboard updates over SSE instead of polling"
    },
    "autoload": {
        "psr-4": {
            "Saifulferoz\\SymfonyHorizon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saifulferoz\\SymfonyHorizon\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "ci": [
            "@test",
            "@phpstan",
            "@cs"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "phpstan": "Run static analysis",
        "cs": "Check coding standards",
        "ci": "Run everything CI runs"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2-dev"
        }
    },
    "support": {
        "issues": "https://github.com/saifulferoz/symfony-horizon/issues",
        "source": "https://github.com/saifulferoz/symfony-horizon"
    }
}
